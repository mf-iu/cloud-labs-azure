// Dev container for the Azure labs of the cloud computing course.
// It builds the Dockerfile of cloud-labs-local, which must be cloned next to
// this repository (see cloud-labs-local/00-setup), and adds the CLI of
// Azure. Open this folder from WSL in VS Code and choose "Reopen in
// Container". The first start builds the image and takes several minutes.
{
  "name": "Cloud-Kurs: Azure",
  "build": {
    "dockerfile": "../../cloud-labs-local/.devcontainer/Dockerfile",
    "context": "../../cloud-labs-local/.devcontainer"
  },

  // The parent folder is mounted, so that cloud-labs-local, PlaceFinder and
  // the other repositories next to this one are available in the container.
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    // Own Docker Engine inside the container (Docker in Docker)
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    // Azure Functions Core Tools (func) for t09, see provider-tools/
    "./provider-tools": {}
  },

  // SSH keys and the Azure login stay in WSL and survive a rebuild of the container
  "initializeCommand": "mkdir --parents \"$HOME/.ssh\" \"$HOME/.azure\"",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
    "source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind"
  ],

  "remoteUser": "vscode",
  "containerEnv": {
    // The uv cache and the projects are on different file systems
    "UV_LINK_MODE": "copy"
  },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "PlaceFinder" } },

  // Shows the versions of all tools; run both again at any time
  "postCreateCommand": "../cloud-labs-local/tools/check-tools.sh; 01-account/check-cli.sh --tools-only",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "opentofu.vscode-opentofu",
        "ms-azuretools.vscode-azurefunctions"
      ]
    }
  }
}
