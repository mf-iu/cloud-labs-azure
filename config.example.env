# Personal settings for the cloud labs.
# Copy this file to config.env and fill it in. config.env is not committed.
# Your GitHub user and the PlaceFinder image are set in config.env of
# cloud-labs-local (step 00-setup there).

# Short names make all resource names unique: rg-pf-<owner>-t02
PREFIX=pf
OWNER=xy                              # your initials, 2-4 lowercase letters

# Budget alert (01-account), amount in the currency of your subscription
ALERT_EMAIL=you@example.com
BUDGET_AMOUNT=10

# Azure
# Region for all resources. Some subscriptions (e.g. Azure for Students) may
# only use a few regions; 01-account/check-cli.sh shows them.
# Azure for students only allows the following regions:
# italynorth, spaincentral, austriaeast, polandcentral, belgiumcentral
#AZURE_LOCATION=germanywestcentral     # Frankfurt; alternatives: swedencentral, westeurope
AZURE_LOCATION=austriaeast
AZURE_SUBSCRIPTION=                   # optional: subscription id, default: current one

# VM size for 02-vm and 04-network. Standard_B1s and Standard_B2ats_v2 are
# part of the free services. If a size is not available in the region
# (SkuNotAvailable), use the other one.
VM_SIZE=Standard_B2ats_v2

# SSH key for the VMs;
# create it in the WSL shell, not in the dev container:
# ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519
SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519.pub"
